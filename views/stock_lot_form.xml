<odoo>
    <record id="view_stock_lot_form_inherit" model="ir.ui.view">
    <field name="name">stock.lot.form.inherit</field>
    <field name="model">stock.lot</field>
    <field name="inherit_id" ref="stock.view_production_lot_form"/>
    <field name="arch" type="xml">
        <field name="standard_price" position="after">
            <field name="x_documento" widget="many2one"/>
            <button
                name="open_x_documento_spreadsheet"
                string="Abrir en Hoja de Cálculo"
                type="object"
                invisible="not x_documento"
            />
        </field>
    </field>
</record>
</odoo>