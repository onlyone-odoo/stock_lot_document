<odoo>
    <record id="view_stock_lot_form_inherit" model="ir.ui.view">
    <field name="name">stock.lot.form.inherit</field>
    <field name="model">stock.lot</field>
    <field name="inherit_id" ref="stock.view_production_lot_form"/>
    <field name="arch" type="xml">
        <label for="total_value" position="before">
            <field name="x_documento" string="Documento" widget="many2one"/>
            <div class="row">
                <button name="open_x_documento_spreadsheet" string="Abrir en Hoja de Cálculo" type="object" class="btn btn-secondary" invisible="not x_documento"/>
            </div>
            <br/>
        </label>
    </field>
</record>
</odoo>