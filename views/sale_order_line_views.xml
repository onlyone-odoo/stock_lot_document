<odoo>
    <data noupdate="1">
        <record id="view_sale_order_form_inherit_lot_document_button" model="ir.ui.view">
            <field name="name">sale.order.form.inherit.lot.document.button</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='component_lot_id']" position="after">
                    <button name="open_lot_documento_spreadsheet" string="Open in Spreadsheet" type="object" class="btn btn-secondary" invisible="not component_lot_id.x_documento" groups="stock.group_stock_manager"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>