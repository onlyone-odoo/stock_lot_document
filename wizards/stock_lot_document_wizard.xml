<odoo>
    <data noupdate="1">
        <record id="view_stock_lot_document_wizard_form" model="ir.ui.view">
            <field name="name">stock.lot.document.wizard.form</field>
            <field name="model">stock.lot.document.wizard</field>
            <field name="arch" type="xml">
                <form string="Bulk Create Lots from Excels">
                    <group>
                        <field name="product_id"/>
                        <field name="folder_id"/>
                    </group>
                    <footer>
                        <button name="action_bulk_convert_and_link" string="Confirm / Create Lots" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Action to Open Wizard -->
        <record id="action_stock_lot_document_wizard" model="ir.actions.act_window">
            <field name="name">Bulk Create Lot Documents</field>
            <field name="res_model">stock.lot.document.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <!-- Menu Item visible with groups and icon -->
        <menuitem
            id="menu_stock_lot_document_wizard"
            name="Bulk Create Lots from Excels"
            parent="stock.menu_stock_root"
            action="action_stock_lot_document_wizard"
            groups="stock.group_stock_manager"
            sequence="10"/>
    </data>
</odoo>