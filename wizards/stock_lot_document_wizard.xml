<odoo>
    <!-- Wizard Form View -->
    <record id="view_stock_lot_document_wizard_form" model="ir.ui.view">
        <field name="name">stock.lot.document.wizard.form</field>
        <field name="model">stock.lot.document.wizard</field>
        <field name="arch" type="xml">
            <form string="Bulk Convert Excels to Spreadsheets">
                <group>
                    <field name="folder_id"/>
                </group>
                <footer>
                    <button name="action_bulk_convert_and_link" string="Convert and Link" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action to Open Wizard -->
    <record id="action_stock_lot_document_wizard" model="ir.ui.view">
        <field name="name">Bulk Convert Lot Documents</field>
        <field name="res_model">stock.lot.document.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Menu Item under Documents Root -->
    <menuitem
        id="menu_stock_lot_document_wizard"
        name="Bulk Convert Lot Excels"
        parent="documents.menu_root"
        action="action_stock_lot_document_wizard"
        sequence="10"/>
</odoo>